# Claude Code
.claude/

# Dependencies
node_modules/

# Local wrangler dev state (D1 sqlite, etc.)
.wrangler/

# Environment variables
.env
.env.local
.env.*.local
.dev.vars

# Logs
logs/
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Editor directories
.vscode/
.idea/
*.swp
*.swo

# Security/ops audit documents — one-off runbooks for a completed task,
# not durable repo docs. Add future ones here rather than leaving them
# untracked-by-omission at the root.
ungcyberunit_security_remediation.md
cloudflare-migration-verification.md

# Challenge answer key source files — content lives in D1
# (challenge_answer_keys table), never in the repo, since this GitHub repo is
# public. Kept here locally only for re-ingestion (wrangler d1 execute).
answer-keys/

# Proposed-but-not-yet-built feature/curriculum plans — kept local until
# acted on. Once a plan ships, it's un-ignored below and tracked as a
# permanent design-decision record (docs/public-profile-plan.md was the
# original example, named outside this glob; the explicit negations below
# are the same exception applied to the plan-*.md naming convention).
docs/plan-*.md
!docs/plan-audit-log.md
!docs/plan-cheat-sheets.md
!docs/plan-difficulty-tags.md
!docs/plan-discord-pairing.md
!docs/plan-events-page.md
!docs/plan-instructor-analytics.md
!docs/plan-member-directory.md
!docs/plan-question-bank.md

# Build output (if added later)
dist/
build/
